% tmux, remote, sendkey

# Send key to pane
while true; do tmux send-keys -t <SESSION_ID>:<WINDOW_ID>.<PANE_ID> <COMMAND>; sleep 60; done

$ SESSION_ID:
$ WINDOW_ID:
$ PANE_ID:
$ COMMAND: echo "ls ENTER;':pwd' ENTER" | tr ';' '\n'

% tmux, pane, tty

# List tmux panes matching tty
tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id} #{pane_tty} #{pane_current_command} #{pane_current_path}' | grep '<TTY>'
