% cac, ssh

# Exec same command with ssh to specified cac nodes.
cmd_all="<cmd_all>"; for i in {14..16}; do echo ------ node$i -----; ssh -p31888 node$i "${cmd_all}" ; done

$ cmd_all: # commands to run

% cac, sftp
# sftp to cac node
sftp JumpServer:Default/CAC/CACHADOOP/cac-<target_node>/sudoroot/

$ target_node: echo node{7..16} | tr ' ' '\n'
