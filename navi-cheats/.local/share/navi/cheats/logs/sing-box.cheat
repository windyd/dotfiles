% logs, sing-box

# trace error logs
grep -F '[<TRACE_ID> ' ~/Library/Logs/Homebrew/sing-box/box.log

$ TRACE_ID: grep -F 'ERROR [' ~/Library/Logs/Homebrew/sing-box/box.log | tail -100 --- --map "awk -F'\[' '/\[[0-9]+/{print $2}' | cut -d' ' -f1"

# trace key words
grep -F '[<TRACE_ID> ' ~/Library/Logs/Homebrew/sing-box/box.log

$ KEY_WORD:
$ TRACE_ID: grep -F '<KEY_WORD>' ~/Library/Logs/Homebrew/sing-box/box.log | tail -100 --- --map "awk -F'\[' '/\[[0-9]+/{print $2}' | cut -d' ' -f1"
